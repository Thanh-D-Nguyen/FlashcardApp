        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nTap refresh to try again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nNhấn tải lại để thử lại."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n更新ボタンをタップして再試行してください。"
          }
        }
      }
    },
    "%@\nTap to retry.": {
