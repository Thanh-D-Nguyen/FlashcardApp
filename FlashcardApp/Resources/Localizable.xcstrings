  "sourceLanguage": "en",
  "strings": {
    "%@\nTap refresh to try again.": {
      "extractionState": "manual",
      "comment": "Dictionary error; %@ is the reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nTap refresh to try again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nNhấn tải lại để thử lại."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n更新ボタンをタップして再試行してください。"
          }
        }
      }
    },
    "%@\nTap to retry.": {
      "extractionState": "manual",
      "comment": "Footer after a failed page load; %@ is the error",
