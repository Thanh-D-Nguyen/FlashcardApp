    "“%@” and all of its cards will be deleted from this device. This can't be undone.": {
      "extractionState": "manual",
      "comment": "Delete deck confirmation; %@ is the deck name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” and all of its cards will be deleted from this device. This can't be undone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” và toàn bộ thẻ trong đó sẽ bị xóa khỏi thiết bị này. Không thể hoàn tác."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」とそのカードすべてがこのデバイスから削除されます。この操作は取り消せません。"
          }
        }
      }
    },
    "This card already says “%1$@”. Replace it with “%2$@” from the dictionary?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
