      "Public decks from this author will disappear from your account. You can still keep copies already saved on this device.": {
        "extractionState": "manual",
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Public decks from this author will disappear from your account. You can still keep copies already saved on this device."
            }
          },
          "vi": {
            "stringUnit": {
              "state": "translated",
              "value": "Các bộ thẻ công khai của tác giả này sẽ bị ẩn khỏi tài khoản. Bản đã lưu trên thiết bị vẫn còn."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "この投稿者の公開デッキはアカウントから非表示になります。端末に保存済みのコピーは残ります。"
            }
          }
        }
      },
