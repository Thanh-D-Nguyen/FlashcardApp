    "The server rejected this app's request (403). The app's address is not on the server's allow-list, so this needs a server configuration change.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected this app's request (403). The app's address is not on the server's allow-list, so this needs a server configuration change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがアプリのリクエストを拒否しました（403）。アプリのアドレスがサーバーの許可リストにないため、サーバー設定の変更が必要です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ từ chối yêu cầu của ứng dụng (403). Địa chỉ của ứng dụng chưa nằm trong danh sách cho phép của máy chủ, cần chỉnh cấu hình máy chủ."
          }
        }
      }
    },
