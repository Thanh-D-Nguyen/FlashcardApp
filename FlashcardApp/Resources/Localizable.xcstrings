    "A haircut, a clinic visit, the ward office, the bank… Choose what you would say and hear whether it sounds natural." : {
      "comment" : "Description of the situation lessons card on Today",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A haircut, a clinic visit, the ward office, the bank… Choose what you would say and hear whether it sounds natural."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "美容室、病院、役所、銀行…。自分なら何と言うかを選んで、自然な言い方か確かめましょう。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cắt tóc, đi khám bệnh, ra phường, ngân hàng… Chọn câu bạn sẽ nói và nghe xem có tự nhiên không."
          }
        }
      }
    },
