{
  "sourceLanguage" : "en",
  "strings" : {
      "Account Deleted": {
        "extractionState": "manual",
        "localizations": {
          "en": { "stringUnit": { "state": "translated", "value": "Account Deleted" } },
          "vi": { "stringUnit": { "state": "translated", "value": "Đã xóa tài khoản" } },
          "ja": { "stringUnit": { "state": "translated", "value": "アカウントを削除しました" } }
        }
      },
      "Your online account has been deleted. If you used Sign in with Apple, open iPhone Settings > your name > Sign in with Apple, select this app, and stop using Sign in with Apple to revoke access.": {
        "extractionState": "manual",
        "localizations": {
          "en": { "stringUnit": { "state": "translated", "value": "Your online account has been deleted. If you used Sign in with Apple, open iPhone Settings > your name > Sign in with Apple, select this app, and stop using Sign in with Apple to revoke access." } },
          "vi": { "stringUnit": { "state": "translated", "value": "Tài khoản trực tuyến của bạn đã được xóa. Nếu đã dùng Đăng nhập bằng Apple, hãy mở Cài đặt iPhone > tên của bạn > Đăng nhập bằng Apple, chọn ứng dụng này rồi ngừng sử dụng Đăng nhập bằng Apple để thu hồi quyền truy cập." } },
          "ja": { "stringUnit": { "state": "translated", "value": "オンラインアカウントを削除しました。「Appleでサインイン」を利用していた場合は、iPhoneの「設定」> 自分の名前 > 「Appleでサインイン」からこのアプリを選択し、Appleでのサインインを停止してアクセス権を取り消してください。" } }
        }
      },
