#include "BaseConfig.xcconfig"
APP_ENVIRONMENT = local
PRODUCT_DISPLAY_NAME = Flashcard Local
PRODUCT_BUNDLE_IDENTIFIER = com.ds.FlashcardApp.dev
PRODUCT_BASE_URL = http:/$()/localhost:18081/api
// Official Google sample IDs; safe to exercise ad rendering on development builds.
ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
ADMOB_BANNER_UNIT_ID = ca-app-pub-3940256099942544/2435281174
// iOS OAuth client for bundle ID com.ds.FlashcardApp.dev (a different client from production). Empty hides the Google button.
// The local backend must verify the same GOOGLE_OAUTH_CLIENT_ID as GOOGLE_SERVER_CLIENT_ID, or override that here.
GOOGLE_IOS_CLIENT_ID_PREFIX =
#include? "local.local.xcconfig"
