// Copy to development.local.xcconfig when overriding the simulator backend port.
// $() keeps Xcode from interpreting // as a comment.
PRODUCT_BASE_URL = http:/$()/localhost:4000/api
// Optional: iOS OAuth client of com.ds.FlashcardApp.dev (prefix = text before .apps.googleusercontent.com).
// GOOGLE_IOS_CLIENT_ID_PREFIX = 123456789012-abcdefghijklmnopqrstuvwxyz012345
// Optional: web client your local backend verifies, if it differs from the production one.
// GOOGLE_SERVER_CLIENT_ID = 123456789012-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com
